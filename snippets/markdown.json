{
  "eq": {
    "prefix": ["eq"],
    "body": ["\\$\\$", "$1", "\\$\\$ {#eq-${2: label}}"]
  },
  "img": {
    "prefix": ["img"],
    "body": ["![](./img/$1)"]
  },
  "br": {
    "prefix": ["br"],
    "body": ["<br/>"]
  },
  "todo": {
    "prefix": ["todo"],
    "body": ["* [ ] ${1:task} -- due:${2:today} ${3: project:}"]
  },
  "subscript": {
    "prefix": ["sub"],
    "body": ["<sub>$1</sub>"]
  },
  "superscript": {
    "prefix": ["sup"],
    "body": ["<sup>$1</sup>"]
  }
}
